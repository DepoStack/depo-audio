* text=auto
.gitattributes text eol=lf

# Source, configuration, and workflow files are consumed on Unix CI runners.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.plist text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Byte-pinned reviewed notices have extensionless filenames. Keep their
# checked-out bytes identical on Windows and Unix release runners.
scripts/javascript-license-overrides/** text eol=lf

# Native Windows automation keeps conventional CRLF endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Media, models, installer art, and archives are binary.
*.dll binary
*.dylib binary
*.exe binary
*.icns binary
*.ico binary
*.jpg binary
*.onnx binary
*.png binary
*.tgz binary
*.wav binary
*.zip binary
